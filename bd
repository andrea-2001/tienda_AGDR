-- =======================================================
-- BORRAR Y CREAR BASE DE DATOS LIMPIA
-- =======================================================
DROP DATABASE IF EXISTS tienda_db;
CREATE DATABASE tienda_db;
USE tienda_db;

-- =======================================================
-- TABLA: INFORMACION_FISCAL
-- =======================================================
CREATE TABLE informacion_fiscal (
    nif_cif VARCHAR(20) PRIMARY KEY,
    telefono VARCHAR(20),
    direccion_fiscal VARCHAR(200)
);

-- Registro fiscal especial para el cliente anónimo
INSERT INTO informacion_fiscal (nif_cif, telefono, direccion_fiscal)
VALUES ('ANON-NIF', '', '')
ON DUPLICATE KEY UPDATE telefono = telefono;

-- =======================================================
-- TABLA: CLIENTE
-- =======================================================
CREATE TABLE cliente (
    id INT AUTO_INCREMENT PRIMARY KEY,
    nombre VARCHAR(100) NOT NULL,
    email VARCHAR(120) UNIQUE NOT NULL,
    fecha_regist DATE NOT NULL,
    nif_cif VARCHAR(20) NULL,

    CONSTRAINT fk_cliente_fiscal
        FOREIGN KEY (nif_cif)
        REFERENCES informacion_fiscal(nif_cif)
        ON UPDATE CASCADE
        ON DELETE RESTRICT
);

