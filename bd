VALUES (1, 'Cliente Anónimo', 'anonimo@anonimo.com', NOW(), 'ANON-NIF')
ON DUPLICATE KEY UPDATE nombre = nombre;

ALTER TABLE cliente AUTO_INCREMENT = 2;

-- =======================================================
--  TABLA: ARTICULO
-- =======================================================
CREATE TABLE IF NOT EXISTS articulo (
    id INTEGER AUTO_INCREMENT PRIMARY KEY,
    nombre VARCHAR(120) NOT NULL,
    descripcion TEXT,
    precio DECIMAL(10,2) NOT NULL,
    stock INTEGER NOT NULL DEFAULT 0
);

-- =======================================================
--  TABLA: COMPRA
-- =======================================================
CREATE TABLE IF NOT EXISTS compra (
    id INTEGER AUTO_INCREMENT PRIMARY KEY,
    fecha_compra DATE NOT NULL,
    estado VARCHAR(50),
    direccion_envio VARCHAR(200),
    precio_total DECIMAL(10,2),

    cliente_id INTEGER NOT NULL DEFAULT 1,  -- Por defecto cliente anónimo

    CONSTRAINT fk_compra_cliente
        FOREIGN KEY (cliente_id)
        REFERENCES cliente(id)
        ON UPDATE CASCADE
        ON DELETE RESTRICT  -- No se puede borrar cliente si tiene compras
);

-- =======================================================
--  TABLA INTERMEDIA: ARTICULO_COMPRA
-- =======================================================
CREATE TABLE IF NOT EXISTS articulo_compra (
    articulo_id INTEGER NOT NULL,
    compra_id INTEGER NOT NULL,
    unidades INTEGER NOT NULL,
    precio_compra DECIMAL(10,2) NOT NULL,

    PRIMARY KEY (articulo_id, compra_id),

    CONSTRAINT fk_ac_articulo
        FOREIGN KEY (articulo_id)
        REFERENCES articulo(id)
        ON UPDATE CASCADE
        ON DELETE CASCADE,

    CONSTRAINT fk_ac_compra
        FOREIGN KEY (compra_id)
        REFERENCES compra(id)
        ON UPDATE CASCADE
        ON DELETE CASCADE
);
