-- =======================================================
--  CREAR BASE DE DATOS Y USARLA
-- =======================================================
CREATE DATABASE IF NOT EXISTS tienda_db;
USE tienda_db;

-- =======================================================
--  TABLA: INFORMACION_FISCAL
-- =======================================================
CREATE TABLE IF NOT EXISTS informacion_fiscal (
    nif_cif VARCHAR(20) PRIMARY KEY,
    telefono VARCHAR(20),
    direccion_fiscal VARCHAR(200)
);

-- -------------------------------------------------------
--  Crear registro fiscal especial para el cliente anónimo
-- -------------------------------------------------------
INSERT INTO informacion_fiscal (nif_cif, telefono, direccion_fiscal)
VALUES ('ANON-NIF', '', '')
ON DUPLICATE KEY UPDATE telefono = telefono;

-- =======================================================
--  TABLA: CLIENTE
-- =======================================================
CREATE TABLE IF NOT EXISTS cliente (
    id INTEGER AUTO_INCREMENT PRIMARY KEY,
    nombre VARCHAR(100) NOT NULL,
    email VARCHAR(120) UNIQUE NOT NULL,
    fecha_regist DATE NOT NULL,
    nif_cif VARCHAR(20) NOT NULL,

    CONSTRAINT fk_cliente_fiscal
        FOREIGN KEY (nif_cif)
        REFERENCES informacion_fiscal(nif_cif)
        ON UPDATE CASCADE
        ON DELETE RESTRICT  -- No se puede borrar info fiscal si tiene clientes
);

-- -------------------------------------------------------
--  Crear cliente ANÓNIMO que absorberá compras de clientes borrados
-- -------------------------------------------------------
