-- =======================================================
-- TABLA: ARTICULO
-- =======================================================
CREATE TABLE articulo (
    id INT AUTO_INCREMENT PRIMARY KEY,
    nombre VARCHAR(150) NOT NULL,
    descripcion VARCHAR(500),
    precio DECIMAL(10,2) NOT NULL,
    stock INT NOT NULL DEFAULT 0
);

-- =======================================================
-- TABLA: COMPRA
-- =======================================================
CREATE TABLE compras (
    id INT AUTO_INCREMENT PRIMARY KEY,
    fecha_compra DATE NOT NULL,
    estado ENUM('ENTREGADO','ENVIADO','PENDIENTE') DEFAULT 'PENDIENTE',
    direccion_envio VARCHAR(200),
    precio_total DECIMAL(10,2),

    cliente_id INT NOT NULL DEFAULT 1,

    CONSTRAINT fk_compra_cliente
        FOREIGN KEY (cliente_id)
        REFERENCES cliente(id)
        ON UPDATE CASCADE
        ON DELETE RESTRICT
);

-- =======================================================
-- TABLA INTERMEDIA: ARTICULO_COMPRA (N:N)
-- =======================================================
CREATE TABLE articulo_compra (
    articulo_id INT NOT NULL,
    compra_id INT NOT NULL,
    unidades INT NOT NULL,
    precio_compra DECIMAL(10,2) NOT NULL,
    PRIMARY KEY (articulo_id, compra_id),

    CONSTRAINT fk_ac_articulo
        FOREIGN KEY (articulo_id)
        REFERENCES articulo(id)
        ON UPDATE CASCADE
        ON DELETE CASCADE,

    CONSTRAINT fk_ac_compra
        FOREIGN KEY (compra_id)
        REFERENCES compras(id)
        ON UPDATE CASCADE
        ON DELETE CASCADE
);