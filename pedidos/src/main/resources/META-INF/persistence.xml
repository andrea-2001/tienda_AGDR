<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_2.xsd"
    version="3.2">

    <persistence-unit name="gestion-pedidos-pu" transaction-type="RESOURCE_LOCAL">

        <!-- Entidades de tu proyecto -->
        <class>com.gestion.pedidos.Cliente</class>
        <class>com.gestion.pedidos.InformacionFiscal</class>
        <class>com.gestion.pedidos.Compra</class>
        <class>com.gestion.pedidos.Articulo</class>
        <class>com.gestion.pedidos.ArticuloCompra</class>

        <properties>
            <!-- Driver de la base de datos -->
            <property 
                name="jakarta.persistence.jdbc.driver"
                value="org.mariadb.jdbc.Driver" />

            <!-- URL de conexión con parámetros corregidos -->
            <property 
                name="jakarta.persistence.jdbc.url"
                value="jdbc:mariadb://localhost:3306/tienda_db?allowPublicKeyRetrieval=true&amp;useSSL=false&amp;serverTimezone=UTC" />

            <!-- Usuario de la base de datos -->
            <property 
                 name="jakarta.persistence.jdbc.user" 
                 value="tu_usuario"/> 

            <!-- Contraseña de la base de datos -->
            <property 
                name="jakarta.persistence.jdbc.password" 
                value="tu_contraseña"/> 

            <!-- Mostrar sentencias SQL en consola -->
            <property name="hibernate.show_sql" value="true" />
            <property name="hibernate.format_sql" value="true" />

            <!-- Estrategia de generación de esquema -->
            <property name="hibernate.hbm2ddl.auto" value="update" />

            <!-- Configuraciones adicionales -->
            <property name="hibernate.connection.autocommit" value="false" />
            <property name="hibernate.connection.charSet" value="UTF-8" />
            
            <!-- Para mejor rendimiento -->
            <property name="hibernate.jdbc.batch_size" value="20" />
            <property name="hibernate.order_inserts" value="true" />
            <property name="hibernate.order_updates" value="true" />
            
            <!-- Para ver parámetros de consultas -->
            <property name="hibernate.use_sql_comments" value="true" />

        </properties>
    </persistence-unit>
</persistence>